<?xml version="1.0" encoding="utf-8"?>
<!--
  Copyright Amazon.com, Inc. or its affiliates. All Rights Reserved.
  SPDX-License-Identifier: MIT-0

  The whole installation, from this application's point of view.

  Note what is NOT here: no <httpHandlers>, no <httpModules>, no <handlers> entry for the endpoint.
  McpToolAdapter.Web registers its module via PreApplicationStartMethod, so referencing the assembly is
  sufficient. Only the mcp:* settings below are added, and with mcp:enabled absent or false the endpoint
  returns 404 as though it were not installed.
-->
<configuration>

  <appSettings>

    <!-- Master switch. Activation is a reviewable diff, not a side effect of a package restore. -->
    <add key="mcp:enabled" value="true" />

    <!--
      REQUIRED when enabled, minimum 32 characters. Callers present it in the X-Mcp-Key header.

      The value below is a placeholder and the endpoint will refuse it in any real deployment: keep the
      secret wherever this application already keeps secrets. For a WebForms application that usually
      means a configBuilder, an encrypted section (aspnet_regiis -pe), or an appSettings file="" pointing
      outside the web root — not this file in source control.
    -->
    <add key="mcp:sharedSecret" value="REPLACE-WITH-A-32-PLUS-CHARACTER-RANDOM-SECRET" />

    <!--
      The AgentCore target name this endpoint is registered as. Setting it lets the endpoint check at
      start-up that no tool name will breach the model's 64-character limit once AgentCore prepends
      "<targetName>___" — a failure that otherwise appears at invocation time, long after the target was
      created cleanly.

      With this set, leave namePrefix empty: AgentCore already namespaces by target name, and doing both
      spends the name budget twice.
    -->
    <add key="mcp:agentCoreTargetName" value="orderportal" />

    <!-- The URL the gateway will actually call. AgentCore rejects a target without a real server URL. -->
    <add key="mcp:serverUrl" value="https://orders.internal.example.com" />

    <!-- Start read-only. Flip this only once the authorization model is decided. -->
    <add key="mcp:allowMutating" value="false" />

    <!-- Optional: restrict callers to the gateway's addresses. -->
    <!-- <add key="mcp:allowedIpAddresses" value="10.0.12.7,10.0.12.8" /> -->

    <add key="mcp:title" value="Order portal operations" />
    <add key="mcp:maxResultItems" value="200" />

    <!--
      Both must stay false outside development. The first sends legacy exception text — connection
      strings, SQL, internal paths — to callers. The second permits the shared secret to travel over
      plain HTTP.
    -->
    <add key="mcp:includeExceptionDetail" value="false" />
    <add key="mcp:allowInsecureTransport" value="false" />

  </appSettings>

  <system.web>
    <!-- 4.7.2, so the endpoint runs on the same runtime as the rest of the application. -->
    <compilation debug="true" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />

    <!-- Off in a sample; a real application should leave tracing configured as it already has it. -->
    <trace enabled="false" />
  </system.web>

  <system.webServer>
    <!--
      Required for the endpoint to receive extensionless URLs such as /_mcp/openapi.json under the
      integrated pipeline. This is the one setting a WebForms application may genuinely need to add, and
      most already have it.
    -->
    <modules runAllManagedModulesForAllRequests="false" />
  </system.webServer>

</configuration>
