<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Runnable demonstration. Deliberately NOT a shipped package.

    Its purpose is to let you exercise the adapter in one command and see exactly what a gateway
    receives. It is not the recommended way to add MCP tools to a real .NET 8 application — for that,
    use the official MCP C# SDK (ModelContextProtocol), which is built for modern .NET and maintained
    by the people who define the protocol.

    What this does show, usefully, is how little host-specific glue the core needs: the whole
    ASP.NET Core adapter below is about forty lines.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Targets LTS, but runs on any newer installed runtime rather than demanding 8.0 exactly. -->
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>McpToolAdapter.QuickStart</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Maps a Lambda Function URL request onto the ASP.NET Core pipeline. Adding it is a no-op when the
      process is not running in Lambda, so `dotnet run` locally behaves exactly as before.
    -->
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="1.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/McpToolAdapter.Core/McpToolAdapter.Core.csproj" />
    <ProjectReference Include="../../src/McpToolAdapter.Jwt/McpToolAdapter.Jwt.csproj" />
  </ItemGroup>

</Project>
