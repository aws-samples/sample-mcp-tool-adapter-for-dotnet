<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    A realistic ASP.NET Core line-of-business application, used to test the AgentCore round trip
    against something the size and shape of a real system rather than a three-tool demo.

    Deployed privately: no public endpoint. See docs/agentcore-test.md.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OrderPortal</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="1.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/McpToolAdapter.Core/McpToolAdapter.Core.csproj" />
    <ProjectReference Include="../../src/McpToolAdapter.Jwt/McpToolAdapter.Jwt.csproj" />
  </ItemGroup>

</Project>
